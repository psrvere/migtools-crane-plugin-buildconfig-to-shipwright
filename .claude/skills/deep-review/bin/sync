#!/usr/bin/env bash
#
# deep-review vendor sync
#
#   sync              verify vendored files match .manifest, then rebuild SKILL.md
#   sync --check      additionally ask GitHub what changed upstream (read-only)
#   sync --update     fetch upstream, show what changed, rewrite vendor/ + manifest
#   sync --build      rebuild SKILL.md only
#   sync --ref <sha>  pin to a specific commit (default: current pin; with
#                     --update and no --ref, resolves upstream main)
#
# Local edits belong in src/header.md. Anything under vendor/ is machine-managed;
# editing it there is reported as drift and will be overwritten by --update.
#
set -uo pipefail

SKILL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
VENDOR="$SKILL_DIR/vendor"
MANIFEST="$VENDOR/.manifest"
HEADER="$SKILL_DIR/src/header.md"
OUT="$SKILL_DIR/SKILL.md"
REPO="fullsend-ai/agents"

MODE="verify"; REF=""
while [ $# -gt 0 ]; do
  case "$1" in
    --check)  MODE="check" ;;
    --update) MODE="update" ;;
    --build)  MODE="build" ;;
    --ref)    shift; REF="${1:-}" ;;
    -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
  esac
  shift
done

[ -f "$MANIFEST" ] || { echo "FATAL: no $MANIFEST" >&2; exit 1; }
PINNED="$(sed -n 's/^# pinned_sha=//p' "$MANIFEST")"
[ -n "$REF" ] || REF="$PINNED"

red()   { printf '\033[31m%s\033[0m\n' "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
warn()  { printf '\033[33m%s\033[0m\n' "$*"; }

# ---------------------------------------------------------------- build
build() {
  [ -f "$HEADER" ] || { echo "FATAL: missing $HEADER" >&2; exit 1; }
  [ -f "$VENDOR/SKILL.md" ] || { echo "FATAL: missing $VENDOR/SKILL.md" >&2; exit 1; }
  # Strip the vendored YAML frontmatter so the built file has exactly one.
  {
    cat "$HEADER"
    awk 'BEGIN{n=0} /^---[[:space:]]*$/{n++; if(n<=2) next} n>=2{print}' "$VENDOR/SKILL.md"
  } > "$OUT.tmp" && mv "$OUT.tmp" "$OUT"
  green "built SKILL.md ($(wc -l < "$OUT" | tr -d ' ') lines) = src/header.md + vendor/SKILL.md@${PINNED:0:8}"
}

# ------------------------------------------------------- verify local drift
verify() {
  local bad=0 n=0
  while IFS="$(printf '\t')" read -r lp sha up; do
    case "$lp" in \#*|"") continue ;; esac
    n=$((n+1))
    if [ ! -f "$VENDOR/$lp" ]; then red "  MISSING  $lp"; bad=$((bad+1)); continue; fi
    local have; have="$(shasum -a 256 "$VENDOR/$lp" | awk '{print $1}')"
    if [ "$have" != "$sha" ]; then
      red "  EDITED   $lp   (local edit under vendor/ — move it to src/header.md)"
      bad=$((bad+1))
    fi
  done < "$MANIFEST"
  if [ "$bad" -eq 0 ]; then green "vendor/ clean — $n files match .manifest (pin ${PINNED:0:8})"
  else red "vendor/ has $bad problem(s) of $n"; fi
  return $bad
}

# ------------------------------------------------- what changed upstream
check_upstream() {
  command -v gh >/dev/null || { warn "gh not installed — skipping upstream check"; return 0; }
  local head; head="$(gh api "repos/$REPO/commits/main" --jq .sha 2>/dev/null)"
  [ -n "$head" ] || { warn "could not reach $REPO"; return 0; }
  if [ "$head" = "$PINNED" ]; then green "up to date with $REPO main (${head:0:8})"; return 0; fi
  warn "upstream main is ${head:0:8}; you are pinned to ${PINNED:0:8}"
  echo
  echo "Files in this bundle that changed upstream:"
  local any=0
  while IFS="$(printf '\t')" read -r lp sha up; do
    case "$lp" in \#*|"") continue ;; esac
    local newsha
    newsha="$(curl -fsSL "https://raw.githubusercontent.com/$REPO/$head/$up" 2>/dev/null | shasum -a 256 | awk '{print $1}')"
    if [ -z "$newsha" ]; then red "  GONE      $up   (moved or deleted upstream)"; any=1
    elif [ "$newsha" != "$sha" ]; then warn "  CHANGED   $up"; any=1; fi
  done < "$MANIFEST"
  [ "$any" -eq 0 ] && green "  (none — main moved but this bundle is unaffected)"
  echo
  echo "Review their diff, then:  bin/sync --update --ref $head"
  echo "Re-read src/header.md overrides O1-O9 afterwards — upstream may have moved what they patch."
}

# ------------------------------------------------------------- update
update() {
  if [ "$REF" = "$PINNED" ]; then
    local head; head="$(gh api "repos/$REPO/commits/main" --jq .sha 2>/dev/null)"
    [ -n "$head" ] && REF="$head"
  fi
  [ "$REF" != "$PINNED" ] || { green "already at $REF — nothing to do"; return 0; }
  echo "updating ${PINNED:0:8} -> ${REF:0:8}"
  local tmp; tmp="$(mktemp -d)"; local changed=0
  local new_manifest="$tmp/.manifest"
  {
    echo "# fullsend-ai/agents — vendored verbatim. DO NOT EDIT ANYTHING UNDER vendor/."
    echo "# Local changes belong in ../src/header.md. See ../bin/sync."
    echo "# pinned_sha=$REF"
    echo "# fetched_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "# columns: local-path <TAB> sha256 <TAB> upstream-path"
  } > "$new_manifest"

  while IFS="$(printf '\t')" read -r lp sha up; do
    case "$lp" in \#*|"") continue ;; esac
    mkdir -p "$tmp/$(dirname "$lp")"
    if ! curl -fsSL "https://raw.githubusercontent.com/$REPO/$REF/$up" -o "$tmp/$lp"; then
      red "  GONE      $up — upstream moved it. Resolve by hand before continuing."
      rm -rf "$tmp"; return 1
    fi
    local newsha; newsha="$(shasum -a 256 "$tmp/$lp" | awk '{print $1}')"
    if [ "$newsha" != "$sha" ]; then
      warn "  CHANGED   $lp"
      diff -u "$VENDOR/$lp" "$tmp/$lp" | sed 's/^/      /' | head -60
      changed=$((changed+1))
    fi
    printf '%s\t%s\t%s\n' "$lp" "$newsha" "$up" >> "$new_manifest"
  done < "$MANIFEST"

  while IFS="$(printf '\t')" read -r lp sha up; do
    case "$lp" in \#*|"") continue ;; esac
    cp "$tmp/$lp" "$VENDOR/$lp"
  done < "$MANIFEST"
  cp "$new_manifest" "$MANIFEST"
  rm -rf "$tmp"
  PINNED="$REF"
  sed -i '' "s|pinned commit: .*|pinned commit: $REF|" "$VENDOR/NOTICE" 2>/dev/null || true
  green "updated $changed file(s); pin is now ${REF:0:8}"
  [ "$changed" -gt 0 ] && warn "Re-read src/header.md overrides O1-O9 — verify they still apply."
  build
}

case "$MODE" in
  build)  build ;;
  verify) verify; build ;;
  check)  verify; echo; check_upstream ;;
  update) verify >/dev/null; update ;;
esac
