# Test case: Docker-strategy BuildConfig with ImageStreamTag output (BC-014).
# Source: migtools/crane issue #833 (docker-and-s2i) — the Docker BuildConfig.
#
# Sourced by tests/e2e-cluster.sh. Every value may be overridden from the
# environment (the `${VAR:-default}` form lets a global export win), so CI or a
# developer can point the case at a different strategy or registry.

# Resource identity — must match metadata in buildconfig.yaml.
NAMESPACE="${NAMESPACE:-buildconfig-test}"
BUILD_NAME="${BUILD_NAME:-ruby-hello-world-docker}"

# Docker strategy has no builder image; the app ships its own Dockerfile.
BUILDER_IMAGE=""
REGISTRY="${REGISTRY:-registry.kube-system.svc.cluster.local:80}"

# ClusterBuildStrategy the converted Build targets. The plugin defaults Docker to
# "buildah", which the v0.21.x catalog does not ship. "buildah-strategy-managed-push"
# declares the registries-* and dockerfile params and pushes from within the
# strategy honoring --registries-insecure, so it can push to the in-cluster HTTP
# registry.
BUILD_STRATEGY="${BUILD_STRATEGY:-buildah-strategy-managed-push}"

# crane transform optional flags (JSON). No imagestream-mapping needed: the Docker
# strategy has no builder ImageStream reference; only the output ImageStreamTag is
# rewritten via registry-mapping. OCP_REGISTRY is exported by the runner.
OPTIONAL_FLAGS="{\"registry-mapping\":\"${OCP_REGISTRY}=${REGISTRY}\",\"insecure-registries\":\"${REGISTRY}\",\"default-build-strategy\":\"docker=${BUILD_STRATEGY}\"}"

# Cluster + build assertions.
EXPECT_REGISTERED=true      # Shipwright must register the applied Build
RUN_BUILDRUN=true           # create a BuildRun and wait for its result
EXPECT_BUILDRUN=Succeeded   # expected terminal BuildRun condition
BUILD_TIMEOUT="${BUILD_TIMEOUT:-900s}"
